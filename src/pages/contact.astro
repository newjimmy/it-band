---
import '../styles/global.css';
import { company } from '../data/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const pageTitle = `Project inquiry | ${company.name}`;
const canonicalURL = new URL('/contact/', Astro.site);
const description =
  'Discuss cloud architecture, hybrid networking, technical assessment and optimization, or hourly and part-time DevOps consulting with IT Band.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <title>{pageTitle}</title>
  </head>
  <body class="inquiry-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />

    <main class="inquiry-shell" id="main-content">
      <section class="inquiry-hero" aria-labelledby="inquiry-title">
        <p class="eyebrow">Start a conversation</p>
        <h1 id="inquiry-title">Tell us what needs to be fixed, designed or delivered</h1>
        <p>
          Tell us about your Azure, AWS or OCI environment, architecture decisions, hybrid network
          or on-prem integration. We can also discuss Kubernetes, Terraform, CI/CD and platform
          engineering, a cross-discipline technical investigation, or hourly and part-time support.
          The form opens an email draft so you can review the message before sending.
        </p>
      </section>

      <section class="inquiry-layout" aria-label="Project inquiry form">
        <form class="inquiry-form" id="inquiry-form" data-recipient={company.email}>
          <div class="form-row">
            <label>
              <span>Name</span>
              <input name="name" type="text" autocomplete="name" required />
            </label>
            <label>
              <span>Work email</span>
              <input name="email" type="email" autocomplete="email" required />
            </label>
          </div>

          <div class="form-row">
            <label>
              <span>Company / organization</span>
              <input name="company" type="text" autocomplete="organization" />
            </label>
            <label>
              <span>Preferred contact</span>
              <input name="contact" type="text" placeholder="Email, phone, LinkedIn or Teams" />
            </label>
          </div>

          <label>
            <span>Topic</span>
            <select name="topic" required>
              <option value="">Select the closest topic</option>
              <option value="Technical assessment / optimization">Technical assessment / optimization</option>
              <option value="Hourly / part-time DevOps support">Hourly / part-time DevOps support</option>
              <option>Cloud architecture / landing zone</option>
              <option>On-prem to cloud migration</option>
              <option>Hybrid networking / VPN / DNS / connectivity</option>
              <option>Kubernetes / platform engineering</option>
              <option>CI/CD / GitOps / release automation</option>
              <option>Terraform / Infrastructure as Code</option>
              <option>Observability / reliability / security</option>
              <option>Team extension / delivery support</option>
              <option>Not sure yet</option>
            </select>
          </label>

          <label>
            <span>Preferred engagement</span>
            <select name="engagement">
              <option>Help me choose</option>
              <option>Diagnose: assessment and recommendations</option>
              <option>Shape the solution: assessment and implementation options</option>
              <option>Implement together: plan and hands-on support</option>
              <option>Lead the delivery: scoped end-to-end implementation</option>
              <option>Hourly / part-time support</option>
              <option>Other architecture / delivery engagement</option>
            </select>
          </label>

          <div class="form-row">
            <label>
              <span>Current environment</span>
              <input name="environment" type="text" placeholder="Azure, OCI, AWS, VMware, on-prem, Kubernetes..." />
            </label>
            <label>
              <span>Timeline</span>
              <select name="timeline">
                <option>Exploring options</option>
                <option>Need input this month</option>
                <option>Active project</option>
                <option>Urgent / production issue</option>
              </select>
            </label>
          </div>

          <label>
            <span>Short problem summary</span>
            <textarea
              name="summary"
              rows="7"
              placeholder="What is the business or technical problem? What is painful today? What would a good outcome look like?"
              required
            ></textarea>
          </label>

          <label>
            <span>Useful constraints</span>
            <textarea
              name="constraints"
              rows="4"
              placeholder="Security, compliance, network, legacy systems, internal teams, budget, deadlines, preferred cloud or tooling."
            ></textarea>
          </label>

          <div class="form-actions">
            <button class="button primary" type="submit">Prepare message</button>
            <a class="button secondary" href={`mailto:${company.email}`}>Email directly</a>
          </div>

          <p class="form-note">
            No data is stored by this static site. Submitting prepares an email draft on your device.
            Describe the issue at a high level; do not include credentials, customer data or confidential logs.
          </p>
        </form>

        <aside class="inquiry-aside">
          <h2>Good first conversation</h2>
          <ul>
            <li>Business goals and architecture decisions</li>
            <li>Azure, AWS, OCI and on-prem dependencies</li>
            <li>Network topology, security and delivery constraints</li>
            <li>What is blocked, risky or too slow today</li>
            <li>Whether you need assessment, optimization, troubleshooting or implementation</li>
            <li>Internal delivery team, access boundaries and preferred level of help</li>
          </ul>
          <p class="form-note">This is not a 24/7 emergency response channel. For an active incident, follow your existing incident-response process first.</p>
          <div class="aside-contact">
            <span>{company.location}</span>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </div>
        </aside>
      </section>
    </main>
    <SiteFooter />

    <script>
      const form = document.querySelector('#inquiry-form');
      const inquiryTopic = new URLSearchParams(window.location.search).get('topic');
      const topicSelect = form?.querySelector('select[name="topic"]');
      const engagementSelect = form?.querySelector('select[name="engagement"]');
      if (topicSelect instanceof HTMLSelectElement) {
        if (inquiryTopic === 'advisory' || inquiryTopic === 'recovery') topicSelect.value = 'Technical assessment / optimization';
        if (inquiryTopic === 'devops') {
          topicSelect.value = 'Hourly / part-time DevOps support';
          if (engagementSelect instanceof HTMLSelectElement) engagementSelect.value = 'Hourly / part-time support';
        }
      }
      form?.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const get = (key) => String(data.get(key) || '').trim();
        const subject = `[IT Band inquiry] ${get('topic') || 'Architecture conversation'}`;
        const body = [
          `Name: ${get('name')}`,
          `Email: ${get('email')}`,
          `Company: ${get('company')}`,
          `Preferred contact: ${get('contact')}`,
          `Topic: ${get('topic')}`,
          `Preferred engagement: ${get('engagement')}`,
          `Current environment: ${get('environment')}`,
          `Timeline: ${get('timeline')}`,
          '',
          'Short problem summary:',
          get('summary'),
          '',
          'Useful constraints:',
          get('constraints'),
        ].join('\n');

        const recipient = form.dataset.recipient || '';
        const mailto = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        window.location.href = mailto;
      });
    </script>
  </body>
</html>
