---
import SiteLayout from '../layouts/SiteLayout.astro';
import { company, overviewCards, proofPoints } from '../data/site';
---

<SiteLayout
  title={`${company.name} | ${company.descriptor}`}
  description="Cloud architecture, hybrid networking and DevOps across Azure, AWS and OCI. Technical assessment, automation, optimization and implementation support for complex systems."
  bodyClass="overview-page"
>
  <main id="main-content">
      <section class="hero">
        <div class="hero-media" aria-hidden="true">
          <img src="/images/hybrid-cloud-architecture.png" alt="" loading="eager" />
        </div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <p class="eyebrow">Azure · AWS · Oracle Cloud Infrastructure · On-prem</p>
          <h1><span class="heading-line">Cloud architecture</span><span class="heading-line">Hybrid connectivity</span><span class="heading-line">Reliable delivery</span></h1>
          <p class="hero-copy">
            {company.name} connects architecture with hands-on implementation across Azure, AWS,
            OCI and your existing data centers. From network design and secure cloud foundations
            to Kubernetes, Infrastructure as Code and CI/CD, build systems your team can operate.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="/contact/">Book an architecture call</a>
            <a class="button secondary" href="/services/">View services</a>
          </div>
          <a class="recovery-entry" href="/advisory/">
            Need to resolve issues or improve delivery? Explore Technical Advisory <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="proof-strip" aria-label="Experience highlights">
          {proofPoints.map((point) => <span>{point}</span>)}
        </div>
      </section>
      <section class="section overview" aria-labelledby="overview-title">
        <div class="section-heading">
          <p class="eyebrow">Explore IT Band</p>
          <h2 id="overview-title">Find the expertise you need</h2>
          <p>A short overview here. The detail where you need it.</p>
        </div>
        <div class="overview-grid">
          {overviewCards.map((card) => (
            <a class="overview-card" href={card.href}>
              <span class="overview-label">{card.label}</span>
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <span class="overview-action">{card.action} <span aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </section>
  </main>
  <script>
    // Keep existing bookmarked section links useful after the content moves to dedicated pages.
    const previousSections = new Map([
      ['#services', '/services/'], ['#recovery', '/advisory/'], ['#advisory', '/advisory/'],
      ['#work', '/work/'], ['#approach', '/approach/'], ['#contact', '/contact/'],
    ]);
    const destination = previousSections.get(window.location.hash);
    if (destination) window.location.replace(destination);
  </script>
</SiteLayout>
